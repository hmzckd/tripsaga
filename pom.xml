<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.3</version>
		<relativePath/>
	</parent>
	<groupId>com.hmzckd.tripsaga</groupId>
	<artifactId>tripsaga</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>tripsaga</name>
	<description>Travel booking across three services, kept consistent with an orchestrated saga on Temporal</description>

	<modules>
		<module>faults</module>
		<module>booking</module>
		<module>flight</module>
		<module>hotel</module>
		<module>payment</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<temporal.version>1.41.1</temporal.version>
		<wiremock.version>3.13.2</wiremock.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.hmzckd.tripsaga</groupId>
				<artifactId>faults</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.temporal</groupId>
				<artifactId>temporal-sdk</artifactId>
				<version>${temporal.version}</version>
			</dependency>
			<dependency>
				<groupId>io.temporal</groupId>
				<artifactId>temporal-testing</artifactId>
				<version>${temporal.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock-standalone</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
